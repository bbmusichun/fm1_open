# WASI SDK 27 is the compiler the browser preview is built with (README "Build").
# Only the toolchain lives in the image; the repository is bind-mounted at runtime,
# so edits are compiled by tools/Build-Web-Preview.mjs on container start.
FROM node:22

ARG WASI_SDK_URL=https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-27/wasi-sdk-27.0-x86_64-linux.tar.gz
ARG WASI_SDK_SHA256=b7d4d944c88503e4f21d84af07ac293e3440b1b6210bfd7fe78e0afd92c23bc2

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL --retry 3 --output /tmp/wasi-sdk.tar.gz "$WASI_SDK_URL" \
 && echo "$WASI_SDK_SHA256  /tmp/wasi-sdk.tar.gz" | sha256sum -c - \
 && mkdir -p /opt/wasi-sdk \
 && tar -xzf /tmp/wasi-sdk.tar.gz -C /opt/wasi-sdk --strip-components=1 \
 && rm /tmp/wasi-sdk.tar.gz

ENV FM1_WASI_SDK=/opt/wasi-sdk

WORKDIR /workspace
